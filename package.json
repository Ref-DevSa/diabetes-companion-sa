{
  "name": "diabetes-companion-sa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/seed-users.mjs",
    "types": "supabase gen types typescript --local > src/types/database.ts",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:db": "supabase test db",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run scan:secrets && npm run build && npm run test:unit && npm run test:component && npm run test:db && npm run test:int && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "i18next": "^26.7.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
